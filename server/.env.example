PORT=3000

# Logging level: error | warn | info | http | verbose | debug | silly
# Default: debug (development) / info (production)
# LOG_LEVEL=info

# Client (used for SSO redirect)
CLIENT_URL=http://localhost:5173

# SSO Service Configuration
SSO_BASE_URL=http://localhost:3002
SSO_CLIENT_ID=wei_pay
SSO_CLIENT_SECRET=your_sso_client_secret_here

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=wepay_db
# WARNING: 生产环境必须设为 false，使用迁移脚本管理表结构
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT (生产环境请使用足够长度的随机串，例如 `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_here
# Token 有效期（默认 1440m = 24 小时）
JWT_EXPIRES_IN=1440m

# Gateway (商户接入签名密钥)
GATEWAY_SECRET=your_gateway_secret_here

# 商户 appSecret 等敏感字段的 AES-256-GCM 加密密钥
# 必须为 32 字节，可填 hex(64位) / base64 / 任意字符串（会做 SHA-256 派生）
# 生成示例：openssl rand -hex 32
# 未设置时会自动从 JWT_SECRET 派生（仅适用于开发，生产必填）
ENCRYPTION_KEY=

# 是否启用沙箱测试接口（/api/native-pay/test-pay、/sandbox-confirm）
# 生产环境必须为 false
ENABLE_SANDBOX=true

# 全局限流：每个 IP 在 TTL 毫秒内允许的最大请求数
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# 汇率服务
# Provider: open-er-api（默认，免费）| static
EXCHANGE_RATE_PROVIDER=open-er-api
EXCHANGE_RATE_CACHE_TTL_MS=3600000
# 失败时的兜底 CNY->USD 汇率
FALLBACK_CNY_TO_USD=0.14
# 加点（用于覆盖汇率波动；1 = 不加点，0.98 = 缩水 2%）
EXCHANGE_RATE_MARGIN=1

# 手续费模型（费率以小数表示：0.006 = 0.6%）
# 商户侧费率
FEE_RATE_ALIPAY=0.006
FEE_RATE_PAYPAL=0.044
FEE_RATE_NATIVE=0
# 上游 PSP 渠道成本
CHANNEL_COST_ALIPAY=0.006
CHANNEL_COST_PAYPAL=0.044
CHANNEL_COST_NATIVE=0
# 单笔手续费下限（cents）
FEE_MIN_CENTS=0

# Alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal 环境：sandbox | live（默认 sandbox）
PAYPAL_ENVIRONMENT=sandbox

# Native Pay（原生存管支付通道配置）
NATIVE_PAY_QR_URL=
NATIVE_PAY_ACCOUNT_NAME=
NATIVE_PAY_ACCOUNT_NO=
NATIVE_PAY_BANK_NAME=

# 数据库连接池大小（默认 10）
# DB_POOL_SIZE=10

# SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
